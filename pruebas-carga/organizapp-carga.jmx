      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="CP-03 Edición del diagrama (EDITOR)" enabled="true">
        <stringProp name="TestPlan.comments">Flujo de modelado con un usuario EDITOR: abre el diagrama y guarda una versión nueva (escritura + historial).</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(cp03.usuarios,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(cp03.rampa,30)}</stringProp>
